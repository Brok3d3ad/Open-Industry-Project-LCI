[gd_scene format=3 uid="uid://csekr7nhdlmu0"]

[ext_resource type="Script" uid="uid://gat6xfeiidsw" path="res://addons/oip_comms/controls/oip_comms_dock.gd" id="1_ac54y"]

[node name="Dock" type="MarginContainer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 4
theme_override_constants/margin_right = 4
theme_override_constants/margin_top = 4
theme_override_constants/margin_bottom = 4
script = ExtResource("1_ac54y")

[node name="Layout" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Toolbar" type="HBoxContainer" parent="Layout"]
layout_mode = 2

[node name="EnableComms" type="CheckBox" parent="Layout/Toolbar"]
layout_mode = 2
text = "Enable Comms"
tooltip_text = "Master switch for OIPComms.

When off, no reads or writes occur even if the simulation is running.

State is persisted to res://oip_data/comms_settings.cfg."

[node name="EnableLogging" type="CheckBox" parent="Layout/Toolbar"]
layout_mode = 2
text = "Enable Logging"
tooltip_text = "When on, OIPComms prints additional diagnostic messages to the output.

Errors are always logged regardless of this setting."

[node name="Spacer" type="Control" parent="Layout/Toolbar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="AddTagGroup" type="Button" parent="Layout/Toolbar"]
layout_mode = 2
text = "Add Tag Group"
tooltip_text = "Add a new tag group.

Each group represents one connection to a device (PLC, OPC UA server, robot)."

[node name="Save Changes" type="Button" parent="Layout/Toolbar"]
layout_mode = 2
disabled = true
text = "Save Changes"
tooltip_text = "Persist the current dock state to res://oip_data/tag_groups.cfg.

Re-registers all tag groups with OIPComms."

[node name="HSeparator" type="HSeparator" parent="Layout"]
layout_mode = 2

[node name="ScrollContainer" type="ScrollContainer" parent="Layout"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 110)

[node name="TagGroupList" type="VBoxContainer" parent="Layout/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3

[connection signal="toggled" from="Layout/Toolbar/EnableComms" to="." method="_on_EnableComms_toggled"]
[connection signal="toggled" from="Layout/Toolbar/EnableLogging" to="." method="_on_EnableLogging_toggled"]
[connection signal="pressed" from="Layout/Toolbar/AddTagGroup" to="." method="_on_AddTagGroup_pressed"]
