[node name="BrowseOpcUa" type="Button" parent="Row2"]
layout_mode = 2
text = "Browse"
visible = false
tooltip_text = "Open the OPC UA Browser dock to inspect this server's address space and pick node IDs.

Requires the OPC UA Browser plugin to be enabled."

[node name="HSeparator" type="HSeparator" parent="."]
layout_mode = 2

