[gd_scene format=3 uid="uid://b0wmg3bm6lht7"]

[ext_resource type="Script" uid="uid://d362g8dqm3op5" path="res://addons/oip_comms/controls/tag_group.gd" id="1_ugh8j"]

[node name="TagGroup" type="VBoxContainer"]
size_flags_horizontal = 3
script = ExtResource("1_ugh8j")

[node name="Row1" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="NameLabel" type="Label" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(40, 0)
mouse_filter = 1
text = "Name"
tooltip_text = "Unique identifier for this tag group.

Scripts (Conveyor, Sensor, etc.) reference this name when reading or writing tags."

[node name="Name" type="LineEdit" parent="Row1"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(80, 0)
select_all_on_focus = true

[node name="ProtocolLabel" type="Label" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(55, 0)
mouse_filter = 1
text = "Protocol"
tooltip_text = "Communication protocol for this tag group.
The fields below adapt to the selected protocol.

ab_eip: Allen-Bradley EtherNet/IP
modbus_tcp: Modbus TCP
opc_ua: OPC UA server
siemens put/get: Siemens S7
ads: Beckhoff TwinCAT
rtde: Universal Robots"

[node name="Protocol" type="OptionButton" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(110, 0)
selected = 0
item_count = 5
popup/item_0/text = "ab_eip"
popup/item_0/id = 0
popup/item_1/text = "modbus_tcp"
popup/item_1/id = 1
popup/item_2/text = "opc_ua"
popup/item_2/id = 2
popup/item_3/text = "siemens put/get"
popup/item_3/id = 3
popup/item_4/text = "ads"
popup/item_4/id = 4

[node name="PollingRateLabel" type="Label" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(75, 0)
mouse_filter = 1
text = "Polling (ms)"
tooltip_text = "How often (in milliseconds) tags in this group are read from the device.

Lower = fresher data but more network and PLC comm-task load.

Writes happen immediately and don't wait for the polling interval."

[node name="PollingRate" type="SpinBox" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(80, 0)
max_value = 1000000.0
value = 100.0
rounded = true

[node name="ConnectionsLabel" type="Label" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(50, 0)
mouse_filter = 1
text = "Conn."
tooltip_text = "Number of parallel libplctag sessions for this group.

Tags are sharded across sessions by a stable hash of the tag name, so a tag stays pinned to the same session across runs.

Only meaningful for ab_eip and modbus_tcp.

1 = original behavior
4 = good default for a single ControlLogix simulator
~16+ = returns drop off as Godot/network RTT dominate

Higher counts shouldn't be used against a production PLC."

[node name="Connections" type="SpinBox" parent="Row1"]
layout_mode = 2
custom_minimum_size = Vector2(60, 0)
min_value = 1.0
max_value = 32.0
value = 1.0
rounded = true

[node name="Delete" type="Button" parent="Row1"]
layout_mode = 2
text = "Delete"
tooltip_text = "Remove this tag group.

Tags assigned to this group will no longer be readable or writable until the group is recreated."

[node name="Row2" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="GatewayLabel" type="Label" parent="Row2"]
layout_mode = 2
custom_minimum_size = Vector2(55, 0)
mouse_filter = 1
text = "Gateway"

[node name="Gateway" type="LineEdit" parent="Row2"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(80, 0)
select_all_on_focus = true

[node name="PathLabel" type="Label" parent="Row2"]
layout_mode = 2
custom_minimum_size = Vector2(55, 0)
mouse_filter = 1
text = "Path"

[node name="Path" type="LineEdit" parent="Row2"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(60, 0)
select_all_on_focus = true

[node name="CPURow" type="HBoxContainer" parent="Row2"]
layout_mode = 2

[node name="CPULabel" type="Label" parent="Row2/CPURow"]
layout_mode = 2
custom_minimum_size = Vector2(30, 0)
mouse_filter = 1
text = "CPU"

[node name="CPU" type="OptionButton" parent="Row2/CPURow"]
layout_mode = 2
custom_minimum_size = Vector2(110, 0)
selected = 0
item_count = 7
popup/item_0/text = "ControlLogix"
